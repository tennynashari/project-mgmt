[Unit]
Description=Project Management API Server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=projectapp
Group=projectapp
WorkingDirectory=/var/www/project-mgmt/server
EnvironmentFile=/var/www/project-mgmt/server/.env
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=10
StandardOutput=append:/var/www/project-mgmt/server/logs/app.log
StandardError=append:/var/www/project-mgmt/server/logs/error.log

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/www/project-mgmt/server/logs

[Install]
WantedBy=multi-user.target
