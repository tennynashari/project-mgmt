[Unit]
Description=Project Management API Server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=projectapp
Group=projectapp
WorkingDirectory=/home/projectapp/project/server
EnvironmentFile=/home/projectapp/project/server/.env
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/projectapp/project/server/logs/app.log
StandardError=append:/home/projectapp/project/server/logs/error.log

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/projectapp/project/server/logs

[Install]
WantedBy=multi-user.target
